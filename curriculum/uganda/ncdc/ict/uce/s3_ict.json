                                        {
                                            "activity_type": "Research/Practical",
                                            "description": "Guide learners to: research about various advanced word processing features (footnotes, mail merge, paragraph, text columns) and how they affect document appearance.",
                                            "source_page": "24"
                                        },
                                        {
                                            "activity_type": "Group Project",
                                            "description": "work in groups to choose a topic or topics and write about it in form of a school magazine (about 4 pages).",
                                            "source_page": "24"
                                        },
                                        {
                                            "activity_type": "Practical/Formatting",
                                            "description": "ensure that the article has the following characteristics:\n- Images at different points with text wrapping around them in different ways.\n- Some of the information in tabular form\n- Use footnotes and end notes\n- Some text in multiple column layout\n- A watermark\n- The document is secured with a password\n- Page numbers in both Arabic and Roman numerals within the same document.\n- A list of figures and tables and a table of contents for the entire document.",
                                            "source_page": "24"
                                        },
                                        {
                                            "activity_type": "Practical/Mail Merge",
                                            "description": "write and send a personalized letter to the parents of 10 (fictional) selected students informing them of their children’s performance (use mail merge).",
                                            "source_page": "24"
                                        }
                                    ],
                                    "suggested_assessment_activities": [
