                                            "description": "Guide learners to: name the ICT Technologies they know of and how they are used in the everyday life."
                                        },
                                        {
                                            "activity_type": "Identification/Description",
                                            "description": "Use ICT equipment, and in pairs or in groups, ask them to: identify and name each of the ICT tools, and describe how they are used."
                                        },
                                        {
                                            "activity_type": "Research/Group Discussion",
                                            "description": "Use ICT equipment, and in pairs or in groups, ask them to: research on specialised applicationsof ICTs in various fields; health, industry, transport, banks, communication, education, security and allow them to discuss in groups."
                                        },
                                        {
                                            "activity_type": "Study/Presentation",
                                            "description": "Use ICT equipment, and in pairs or in groups, ask them to: work in pairs to study user manuals for a variety of ICT tools, summarise and present the safety precautions in awhole class discussion."
                                        },
                                        {
                                            "activity_type": "Practical Operation",
                                            "description": "Use ICT equipment, and in pairs or in groups, ask them to: operate available ICT tools to producea product i.e. taking a photograph using a camera, typing a text, texting…project using a projector."
                                        },
                                        {
                                            "activity_type": "Discovery Session",
                                            "description": "Use ICT equipment, and in pairs or in groups, ask them to: describe, in a discovery session, the information processing cycle using a simple diagram to illustrate how data is processed into information and stored for future use."
                                        },
                                        {
                                            "activity_type": "Guided Discussion",
                                            "description": "Use ICT equipment, and in pairs or in groups, ask them to: identify, in a guided discussion, possible threats to computers"
                                        },
                                        {
                                            "activity_type": "Group Work/Presentation",
                                            "description": "Use ICT equipment, and in pairs or in groups, ask them to: prepare, in groups, and present rules to govern the use of the computer laboratory."
                                        },
                                        {
                                            "activity_type": "Tutoring Session",
                                            "description": "Use ICT equipment, and in pairs or in groups, ask them to: in a tutoring session in class or computer laboratory to identify some security and safety concerns of ICT tools"
                                        }
