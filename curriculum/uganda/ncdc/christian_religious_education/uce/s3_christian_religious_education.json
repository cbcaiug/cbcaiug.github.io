                                    "suggested_learning_activities": [
                                        {
                                            "activity_type": "Teacher guided",
                                            "description": "The teacher guides learners to:\n• Identify the types of work observed in own community.\n• Brainstorm to construct the meaning of work\n• Illustrate the different types of work in society using examples\n• Discuss reasons for work in modern society\n• Explain the nature of work in modern society with a focus on professional, talent-based, online, middleman and non- professional jobs.\n• Explain the value of community participation\n• Discuss the traditional African practices of work\n• Use the internet to research and explain the types of work in traditional African society\n• Understand the division of working in traditional African society"
                                        },
                                        {
                                            "activity_type": "Small groups",
                                            "description": "In small groups, the teacher guides learners to:\n• Discuss the importance of voluntary work in society and in the community.\n• Explain the importance of the following ideals in work: responsibility, dedication, determination, honesty and co-operation\n• Relate work to happiness\n• Discuss the role of education in work today."
                                        },
                                        {
                                            "activity_type": "Plenary",
                                            "description": "In plenary, the teacher guides learners to:\nDefine work ethics\n• Explain the need for work ethics\n• Discuss professional ethics using a case study of medical workers\n• Discuss the importance of professional ethics.\n• Explain agreeable and disagreeable behaviors at a workplace"
                                        },
                                        {
                                            "activity_type": "Small groups",
                                            "description": "In small groups, the teacher guides learners to:\n• Discuss the qualities of a good worker/ employee\n• Discuss the qualities of a good employer"
                                        },
                                        {
                                            "activity_type": "Teacher guided",
                                            "description": "The teacher guides learners to:\n• Identify challenges in work today with a special focus on unemployment, exploitation and irresponsible and unprofessional behaviour.\n• Suggest ways of overcoming the challenges and write them in your exercise book."
                                        },
                                        {
                                            "activity_type": "Pair work",
                                            "description": "In pairs, learners\n• Tell each other what they would do if they became employees\n• Use the Bible to explain ways through which challenges of work can be overcome."
                                        },
                                        {
                                            "activity_type": "Teacher guided",
                                            "description": "The teacher guides learners to:\n• Identify and record the aspects of work in Genesis 1 and 2\n• Explain the importance of work as presented in Proverbs 6:1-10\n• Explain lessons learnt from |Jesus Christ as a worker using Mathew 13:55, Mark 6:3 and Luke 2:49\n• Explain the biblical teachings about work using the following texts:\n• Genesis 29, Leviticus 19:13, Deuteronomy 24:14, James 5:4, Mark 6:3, Mathew 13:55, 25:13-30 and Luke 19:12."
                                        },
                                        {
                                            "activity_type": "Small groups",
                                            "description": "In small groups, learners:\n• Explain community service using the following texts: Hebrews 6:10, Mathew 23:11, 1 Peter 4:10 and Acts of the Apostles 20:35\n• Discuss voluntary work using Titus 3:14, Galatians 6:9 and Mathew 5:6\n• Explain charity work using Psalms 41:1, Proverbs 19:17 and Isaiah 58:10\n• Individually word process or write on the benefits of working in relation to the Bible teachings."
                                        }
                                    ],
                                    "suggested_assessment_activities": [
                                        {
                                            "assessment_type": "Observation",
                                            "description": "• Observe learners’ discussions/ conversation, oral expression and individual contributions."
                                        },
                                        {
                                            "assessment_type": "Written work",
                                            "description": "• Assess the accuracy of their written work and understanding in relation to their Bible references."
                                        },
                                        {
                                            "assessment_type": "Written product analysis",
                                            "description": "• Examine the written products for accuracy"
                                        },
