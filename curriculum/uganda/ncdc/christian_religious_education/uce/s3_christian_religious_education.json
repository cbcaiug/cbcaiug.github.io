                                    "suggested_learning_activities": [
                                        {
                                            "activity_type": "Group work",
                                            "description": "In groups learners:\n• Discuss and construct the meaning of wealth and development\n• Give examples of acceptable ways of acquiring wealth.\n• Identify examples of unacceptable ways of acquiring wealth.\n• Share ideas on the appropriate use and abuse of wealth\n• Use proverbs 3:6, Deuteronomy 8:17-18, Hosea 2:8 and 1 Timothy 6:6-7 to identify teachings about wealth.\n• Give examples of how wealth promotes content and happiness in the community."
                                        },
                                        {
                                            "activity_type": "Research",
                                            "description": "• Use the internet or research on different Christian projects that have influenced development in Uganda.\n• Identify the contribution made by Christianity in the development of Uganda.\n• Using the research carried out, learners make a write up about the contributions made by Christianity to development."
                                        },
                                        {
                                            "activity_type": "Discussion",
                                            "description": "Use examples to explain the importance of generosity with reference to 2 Corinthians 9:6-15 Leviticus 25:35–37, Psalm 41:1–3, Proverbs 11:24–25, Luke 6:37–38)"
                                        },
                                        {
                                            "activity_type": "Discussion",
                                            "description": "• Distinguish between the terms ‘greed’ and ‘corruption’\n• Use examples to explain the dangers of corruption."
                                        },
                                        {
                                            "activity_type": "Discussion",
                                            "description": "• Use examples to show how money and other forms of wealth can contribute to happiness\n• Use examples to show how money and other forms of wealth can reduce happiness"
                                        },
                                        {
                                            "activity_type": "Discussion",
                                            "description": "• Explain the effects of development on the environment."
                                        },
                                        {
                                            "activity_type": "Teacher guided",
                                            "description": "Guide learners to:\n• Discuss and construct the meaning and composition of wealth in Traditional Africa.\n• Discuss ways through which wealth was acquired in Traditional Africa\n• Relate wealth to development in Traditional Africa.\n• Discuss the value of generosity in Traditional Africa"
                                        }
                                    ],
