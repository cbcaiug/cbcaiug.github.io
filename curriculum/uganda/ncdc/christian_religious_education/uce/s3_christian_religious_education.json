                                    },
                                    "core_competency": "The Learner understands the religious teachings on the value of work, appreciating its importance and developing a positive attitude towards work.",
                                    "prerequisites": [],
                                    "learning_outcomes": [
                                        {
                                            "outcome_text": "Understand the purpose of work (u).",
                                            "domain": "Understanding"
                                        },
