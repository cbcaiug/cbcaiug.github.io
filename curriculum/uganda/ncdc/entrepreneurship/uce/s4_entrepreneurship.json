                    "topic_title": "SUB-TOPIC 14.1: INTRODUCTION TO INTERNATIONAL TRADE",
                    "sequence_order": 1,
                    "recommended_duration_periods": 24,
                    "keywords": [
                      "international trade",
                      "imports",
                      "exports",
                      "balance of trade",
                      "balance of payments",
                      "inco terms",
