                  "suggested_learning_activities": [
                    {
                      "activity_type": "Case Study Analysis",
                      "description": "In groups, learners study a selection of case studies on tax compliance which illustrate tax compliance and non-compliance."
                    },
                    {
                      "activity_type": "Group Discussion/Sorting",
                      "description": "In groups, learners discuss what they notice about the case studies and sort them according to an agreed criterion around tax compliance. Learners explain why they have sorted them out in this way and use evidence from the case studies to support their reasoning."
                    },
                    {
                      "activity_type": "Definition",
                      "description": "In groups, learners agree a definition for tax compliance."
                    },
                    {
                      "activity_type": "Analysis",
                      "description": "They then identify factors that affect tax compliance for each case study, again explaining their reasons."
                    },
                    {
                      "activity_type": "Debate",
                      "description": "Groups debate with another group the advantages and disadvantages of tax compliance, again referring to their case studies."
                    },
                    {
                      "activity_type": "Problem Solving",
                      "description": "Groups agree a list of ways to improve tax compliance, explaining their reasons for suggesting these improvements."
                    }
                  ],
                  "suggested_assessment_activities": [
                    {
                      "assessment_type": "Research/Presentation",
                      "description": "Learners should research statements about tax compliance on the Internet, comparing the way that they are presented. Learners should present their own statement about tax compliance that could be posted on a local government website. Observe the statements that are selected, asking learners to explain their reasons for selecting each one."
                    },
                    {
                      "assessment_type": "Strategy/Conversation",
                      "description": "Ask learners to produce a strategy of reasonable ways for government organisations to respond to instances of non-tax compliance. In conversation, ask learners to explain their reasons for suggesting these strategies."
                    }
