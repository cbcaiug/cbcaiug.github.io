                    ]
                  },
                  "core_competency": "The learner identifies and exploits business opportunities on the international market",
                  "prerequisites": [],
                  "learning_outcomes": [
                    {
                      "outcome_text": "understand what is meant by international trade. (u)",
                      "domain": "Understanding"
                    },
                    {
                      "outcome_text": "know the forms of international trade, including e-commerce. (u, s)",
                      "domain": "Understanding/Skills"
                    },
                    {
                      "outcome_text": "understand reasons for international trade and the various challenges it presents. (u, s) (k)",
                      "domain": "Understanding/Skills/Knowledge"
                    },
                    {
                      "outcome_text": "know International Commercial Terms (INCO terms) (u)",
