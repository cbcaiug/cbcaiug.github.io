                                        "topic_title": "TOPIC 23: MANAGEMENT OF NUTRITIONAL RELATED DISEASES AND DISORDERS",
                                        "sequence_order": 2,
                                        "recommended_duration_periods": 28
                                    },
                                    "core_competency": "The learner follows the guidelines for the management of some nutritionally related conditions to prepare suitable meals for the management of a given nutritionally related conditions.",
                                    "prerequisites": [],
                                    "learning_outcomes": [
                                        {
                                            "outcome_text": "illustrate different nutritionally related conditions (u, s)",
                                            "domain": "u, s"
                                        },
                                        {
                                            "outcome_text": "understand the measures taken in the nutritional management of the above conditions (u)",
                                            "domain": "u"
                                        },
                                        {
                                            "outcome_text": "manage the nutritionally related conditions (u, s, v, a)",
                                            "domain": "u, s, v, a"
                                        },
                                        {
                                            "outcome_text": "design and prepare meals for persons with a nutritionally related disease (u, s, v, a, gs)",
                                            "domain": "u, s, v, a, gs"
                                        },
                                        {
                                            "outcome_text": "manage the effects of alcohol and drugs on nutrient intake (s, gs,v, a)",
                                            "domain": "s, gs,v, a"
                                        }
                                    ],
                                    "content_scope": {
                                        "must_cover": [
                                            "Protein-Energy malnutrition (PEM)",
                                            "obesity",
                                            "anaemia",
                                            "HIV/AIDS",
                                            "anorexia"
                                        ],
                                        "optional_enrichment": [],
                                        "explicitly_excluded": [],
                                        "depth_limitations": []
                                    },
                                    "suggested_learning_activities": [
                                        {
                                            "activity_type": "discussion",
                                            "description": "Use whole class discussion and illustrations to guide learners to describe the signs and symptoms of nutritionally related conditions such as Protein-Energy malnutrition (PEM), obesity, anaemia, HIV/ AIDS, and anorexia."
                                        },
                                        {
                                            "activity_type": "creation",
                                            "description": "Learners could make a chart showing the signs and symptoms of the different forms of PEM."
                                        },
                                        {
                                            "activity_type": "group_work",
                                            "description": "In small groups, learners suggest the guidelines and procedure taken in the management of each of the above nutritionally related diseases."
                                        },
                                        {
                                            "activity_type": "demonstration",
                                            "description": "Use demonstration to show learners how to prepare meals for the management of each of the nutritionally related conditions mentioned above."
                                        },
                                        {
                                            "activity_type": "practical",
                                            "description": "Guide learners to plan and prepare sample meals for some of the above nutritionally related conditions."
                                        },
                                        {
                                            "activity_type": "guest_speaker",
                                            "description": "Learners should listen to a health professional talk about the different nutritionally related conditions and write a report."
                                        },
                                        {
                                            "activity_type": "discussion",
                                            "description": "Guide learners to discuss the effects of alcohol and drugs on nutrition."
                                        },
                                        {
                                            "activity_type": "description",
                                            "description": "Learners describe different ways of managing the alcohol and drug effects using nutrition."
                                        }
                                    ],
                                    "suggested_assessment_activities": [
                                        {
                                            "assessment_type": "conversation",
                                            "description": "Talk to learners about the critical nutritional needs for each condition and the correct procedures to follow in preparation of dishes.(conversation)"
                                        },
                                        {
                                            "assessment_type": "product_analysis",
                                            "description": "Analyse the charts showing comparison of the signs and symptoms of the different forms of PEM.(product)"
                                        },
                                        {
                                            "assessment_type": "product_analysis",
                                            "description": "Analyse sample dishes.(product)"
                                        }
                                    ],
