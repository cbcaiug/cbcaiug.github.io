                                        },
                                        {
                                            "assessment_type": "Research Evaluation",
                                            "description": "Examine the quality and accuracy of the research presented by the learners. Give three examples of Prophet Muhammad’s struggle to bring about peace in Arabia."
                                        },
                                        {
                                            "assessment_type": "Observation",
                                            "description": "Observe learners participate in a discussion on the role of negotiation in attaining peace."
                                        }
