                                        "topic_id": "IRE-O-S3-T1-0001",
                                        "topic_title": "WORK",
                                        "sequence_order": 1,
                                        "recommended_duration_periods": 36
                                    },
                                    "core_competency": "Learners understand religious teachings about the value of work appreciate the importance of work and develop a positive attitude towards work.",
                                    "prerequisites": [],
                                    "learning_outcomes": [
                                        {
                                            "outcome_text": "appreciate the value and purpose of work (u)",
                                            "domain": "understanding"
                                        },
                                        {
                                            "outcome_text": "understand the Islamic ethics of work (u)",
                                            "domain": "understanding"
                                        },
                                        {
                                            "outcome_text": "understand the challenges of work in contemporary life (u)",
                                            "domain": "understanding"
                                        },
                                        {
                                            "outcome_text": "understand the Traditional African views about wealth and development(u)",
                                            "domain": "understanding"
                                        }
                                    ],
                                    "content_scope": {
                                        "must_cover": [
                                            "reasons why people engage in work",
                                            "virtues related to work",
                                            "value of community participation",
                                            "works of Prophets Dawud and Sulaiman in Surat Al-Anbiyaa (21:73-81)",
                                            "Surat Saba (34:10-13) - benefits of hard work",
                                            "Prophet Muhammad as a worker - Surat Al-Ahzab (33:21) and Al-Furqan (21:7)",
                                            "Surat Al-Baqarah (2:23) - begging discouraged",
                                            "Islamic ethics: rights and responsibilities of employers and employees",
                                            "Prohibition of usury (ribah) - Surat Al-Baqarah (2:275, 276 and 278) and Al-Imran (3:130)",
                                            "Prohibition of cheating in weights - Surat Al-Isra (17:35)",
                                            "Methods of commercial transactions - Surat An-Nisa (4:29)",
                                            "Challenges of work: Surat Al-Jumu’ah (62:10) and Al-Najm (53:39)",
                                            "Traditional African views: meaning and composition of wealth, value of generosity"
                                        ],
                                        "optional_enrichment": [],
                                        "explicitly_excluded": [],
                                        "depth_limitations": []
                                    },
                                    "suggested_learning_activities": [
                                        {
                                            "activity_type": "Discussion",
                                            "description": "share ideas about reasons why people engage in work."
                                        },
                                        {
                                            "activity_type": "Exposition",
                                            "description": "use examples to explain the virtues related to any kind of work."
                                        },
                                        {
                                            "activity_type": "Case Study",
                                            "description": "use examples of the works of Prophets Dawud and Sulaiman in Surat Al-Anbiyaa (21:73-81) to illustrate the different types of work done by people in their societies."
                                        },
                                        {
                                            "activity_type": "Textual Analysis",
                                            "description": "use Surat Al-Ahzab (33:21) and Al-Furqan (21:7) to describe Prophet Muhammad as a worker."
                                        },
                                        {
                                            "activity_type": "Group Discussion",
                                            "description": "discuss the rights and responsibilities of employers and employees."
                                        },
                                        {
                                            "activity_type": "Role Play",
                                            "description": "Participate in a role-play demonstrating the challenges of work in modern society."
                                        }
                                    ],
                                    "suggested_assessment_activities": [
                                        {
                                            "assessment_type": "Observation",
                                            "description": "Listen to learners’ discussions/ conversation, oral expression and individual contributions."
                                        },
                                        {
                                            "assessment_type": "Product Evaluation",
                                            "description": "Assess the accuracy of their written work understanding in relation to their Quran references."
                                        },
                                        {
                                            "assessment_type": "Presentation",
                                            "description": "Listen to learners’ presentations of Prophet Muhammad’s model to show ways through which beggars can be helped out of their situation."
                                        }
